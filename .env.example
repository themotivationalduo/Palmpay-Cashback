# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PAYSTACK_PUBLIC_KEY: Public key for fetching banks and verifying NUBAN accounts
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"

# PAYSTACK_SECRET_KEY: Secret key required for resolving live bank account holder names (Bearer sk_live_...)
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"

# SITE_B_API_URL: Server endpoint on Site B where approved withdrawals are disbursed
SITE_B_API_URL="https://site-b.example.com/api/transfers"

# INTERNAL_API_SECRET: Shared secret key passed in x-api-secret authorization header to Site B
INTERNAL_API_SECRET="your_shared_internal_api_secret_key"
